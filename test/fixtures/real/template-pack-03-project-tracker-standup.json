    {
      "parameters": {
        "jsCode": "// ---- Edit after importing ----\nconst ALLOWED_CHAT_IDS = ['YOUR_TELEGRAM_CHAT_ID']; // only these chats may use the bot (it spends API credits)\nconst MODEL = 'gpt-4o-mini';\n// ------------------------------\nconst msg = $input.first().json.message || {};\nconst chatId = msg.chat?.id;\nif (!chatId || !ALLOWED_CHAT_IDS.map(String).includes(String(chatId))) return []; // silently ignore strangers\nreturn [{ json: {\n  model: MODEL, chat_id: chatId, message_id: msg.message_id,\n  text: (msg.text || msg.caption || '').trim().slice(0, 2000),\n  received_at: new Date((msg.date || Date.now() / 1000) * 1000).toISOString(),\n} }];"
      },
      "id": "88fb3d66-22cc-5b8b-bbba-2890b2abc89a",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const clean = (v, max = 500) => {\n  if (v === null || v === undefined) return '';\n  let s = String(v).replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]/g, '').slice(0, max);\n  if (/^[=+\\-@\\t\\r]/.test(s)) s = \"'\" + s; // block spreadsheet formula injection\n  return s;\n};\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// /task Judul | Project | 2026-10-20 | high      -> add a task\n// /done T-1234                                   -> mark done\n// /list                                          -> standup now\nconst j = $input.first().json;\nconst t = j.text;\nlet m;\nif ((m = t.match(/^\\/task(?:@\\w+)?\\s+(.+)$/is))) {\n  const [title, project = 'General', due = '', prio = 'medium'] = m[1].split('|').map((x) => x.trim());\n  if (!title) return [{ json: { ...j, cmd: 'help' } }];\n  const dueOk = /^\\d{4}-\\d{2}-\\d{2}$/.test(due) && !isNaN(Date.parse(due));\n  const priority = ['low', 'medium', 'high'].includes(prio.toLowerCase()) ? prio.toLowerCase() : 'medium';\n  return [{ json: { ...j, cmd: 'add', task: { id: 'T-' + Date.now().toString(36).toUpperCase(), task: clean(title, 200),\n    project: clean(project, 80), due_date: dueOk ? due : '', priority, status: 'todo', created_at: new Date().toISOString() } } }];\n}\nif ((m = t.match(/^\\/done(?:@\\w+)?\\s+(T-[A-Z0-9]+)$/i))) return [{ json: { ...j, cmd: 'done', id: m[1].toUpperCase() } }];\nif (/^\\/list/i.test(t)) return [{ json: { ...j, cmd: 'list' } }];\nreturn [{ json: { ...j, cmd: 'help' } }];"
      },
